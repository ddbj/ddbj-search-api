// db-portal search query grammar (Lark LALR(1)).
// SSOT: db-portal/docs/search-backends.md §パーサ実装
//       db-portal/docs/search.md §採用構文
// Unsupported on purpose: boost `^`, fuzzy `~`, regex `/.../`, bare wildcard.

start: or_expr

or_expr: and_expr (OR and_expr)*
and_expr: not_expr (AND not_expr)*
not_expr: NOT atom   -> not_op
        | atom       -> atom_passthrough
?atom: field_clause
     | free_text_atom
     | "(" or_expr ")"
// Field name and free-text token share the WORD terminal; the parser
// distinguishes the two by 1-token lookahead on the following ``:``.
field_clause: WORD ":" value
// Space-separated bare words (e.g. ``cancer tumor``) collapse into a single
// free-text value; the compiler AND-combines the intra-value spaces
// (``multi_match.operator=and``).
free_text_atom: PHRASE -> ft_phrase
              | WORD+  -> ft_word

value: PHRASE    -> v_phrase
     | RANGE     -> v_range
     | WILDCARD  -> v_wildcard
     | DATE      -> v_date
     | WORD      -> v_word

// AND / OR / NOT must outrank WORD so a bare ``NOT`` is recognised as the
// operator instead of being absorbed into ``free_text_atom: WORD``. An operator
// must not be followed by a WORD character, so ``NOTCH1`` and ``ORGANOID`` are
// words while ``NOT(a)``, ``a OR "x"``, and ``NOT'x'`` read the operator.
AND.10: /AND(?![^\s:()\[\]"'{}^~*?\/])/
OR.10: /OR(?![^\s:()\[\]"'{}^~*?\/])/
NOT.10: /NOT(?![^\s:()\[\]"'{}^~*?\/])/

// A single-quoted phrase closes at a `'` that a space, `)`, or the end follows.
// A `'` inside the phrase that another character follows is part of the
// phrase, as in 'Alzheimer's disease'.
PHRASE.5: /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.|'(?=[^\s)]))*'(?![^\s)])/
RANGE.5: /\[[^\s\]]+\s+TO\s+[^\s\]]+\]/
DATE.4: /\d{4}-\d{2}-\d{2}/
// WILDCARD is intentionally a narrower character class than WORD: only
// alphanumerics, `_`, `-`, `.` plus the wildcard markers `*` / `?`.
// Symbol-bearing tokens like ``HIF-1*`` / ``COVID-19*`` must parse as
// wildcards so users can prefix-search gene / disease names, but Lucene /
// Solr metacharacters (`\`, `+`, leading `-`, `!`, `|`, `&`, `<`, `>`, `=`)
// are kept out at the grammar level to avoid downstream escape bugs.
WILDCARD.3: /[A-Za-z0-9_\-.]*[*?][A-Za-z0-9_\-.]*/
// A WORD does not start where a single-quoted phrase starts, so a closed '...'
// after a word is a syntax error, as a phrase next to a word is. A `'` that no
// closing `'` follows starts a word, as in `'s`.
WORD.1: /(?!'(?:[^'\\]|\\.|'(?=[^\s)]))*'(?![^\s)]))[^\s:()\[\]"{}^~*?\/]+/

%ignore /\s+/
